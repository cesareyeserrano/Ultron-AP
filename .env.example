# Ultron-AP — Environment Variables
# Copy to .env and fill in values before starting.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Admin password (bcrypt hash — NOT plaintext).
# Generate: htpasswd -bnBC 10 "" <password> | tr -d ':\n'
# Type:     string  Required: yes
# Example:  $2y$10$e0NRm...
ULTRON_ADMIN_PASS=

# ── Server ────────────────────────────────────────────────────────────────────

# HTTP listen port.
# Type: integer  Required: no  Default: 8080
ULTRON_PORT=8080

# Absolute path to the SQLite database file.
# Type: string  Required: no  Default: ./ultron.db
ULTRON_DB_PATH=/var/lib/ultron-ap/ultron.db

# Unix socket path for the privileged helper IPC channel.
# Type: string  Required: no  Default: /run/ultron-helper.sock
ULTRON_HELPER_SOCKET=/run/ultron-helper.sock

# ── Telegram Notifications (FR-005) ───────────────────────────────────────────

# Telegram bot token from @BotFather.
# Type: string  Required: no (feature disabled when empty)
# Example: 123456789:AAFhpVsO...
ULTRON_TELEGRAM_TOKEN=

# Telegram chat ID to receive alert messages.
# Type: string  Required: no (feature disabled when empty)
# Example: -1001234567890
ULTRON_TELEGRAM_CHAT_ID=

# ── Email Notifications (FR-006) ──────────────────────────────────────────────

# SMTP server hostname.
# Type: string  Required: no (feature disabled when empty)
# Example: smtp.example.com
ULTRON_SMTP_HOST=

# SMTP server port.
# Type: integer  Required: no  Default: 587
ULTRON_SMTP_PORT=587

# SMTP authentication username.
# Type: string  Required: no
# Example: alerts@example.com
ULTRON_SMTP_USER=

# SMTP authentication password.
# Type: string  Required: no
ULTRON_SMTP_PASS=

# Sender address for outgoing alert emails.
# Type: string  Required: no
# Example: ultron-alerts@example.com
ULTRON_SMTP_FROM=

# ── Backup Encryption ─────────────────────────────────────────────────────────

# AES-256 key (passphrase) used when BackupConfig.encrypt_enabled=1 and
# BackupConfig.encryption_key_ref="env:ULTRON_BACKUP_KEY". Required for the
# automated backup job to succeed when encryption is on; otherwise the job
# fails with "backup encryption key reference is empty" and no .db.enc is
# produced. Use a long, high-entropy value — backups are unrecoverable
# without this exact key.
# Type: string  Required: only when encryption is enabled in BackupConfig
ULTRON_BACKUP_KEY=

# ── Notifications ─────────────────────────────────────────────────────────────

# Public base URL the deep-link footer in Telegram / Email alert messages
# points back to (FR-023). When unset, the dispatcher derives a fallback
# of the form http://<configured-host>:<configured-port>. Set this when
# the dashboard is reachable at a stable hostname or behind a reverse
# proxy / VPN — e.g. https://ultron.example.com or https://ultron.tail.ts.net.
# Type: string  Required: no
ULTRON_PUBLIC_URL=

# ── UPS Monitoring (NUT) ──────────────────────────────────────────────────────

# Enable the UPS module (FR-016). When unset/false the module is fully inert:
# no NUT connection, no UPS card, no alerts. The rest of the panel is unaffected.
# Type: bool  Required: no (default: false)
ULTRON_UPS_ENABLED=

# Dedicated READ-ONLY NUT user for Ultron (RS-1) — create it in
# /etc/nut/upsd.users with a distinct password; do NOT reuse the homeassistant
# user. The password is loaded from here (never committed to the repo).
# Type: string  Required: when ULTRON_UPS_ENABLED=true and upsd requires auth
ULTRON_NUT_USER=
ULTRON_NUT_PASS=

# NUT server address and device name. Defaults suit the local upsd.
# Type: string  Required: no (defaults: 127.0.0.1:3493 / powest)
ULTRON_UPS_ADDR=
ULTRON_UPS_NAME=

# Poll interval and "unreachable" timeout, in seconds.
# Type: int  Required: no (defaults: 10 / 120)
ULTRON_UPS_POLL_SECONDS=
ULTRON_UPS_UNREACHABLE_SECONDS=

# Battery voltage bounds for the ESTIMATED percentage (FR-018). The low bound is
# also shown as the "punto de apagado". low must be < high or both fall back to
# the defaults.
# Type: float  Required: no (defaults: 21.0 / 27.4)
ULTRON_UPS_BATT_LOW_V=
ULTRON_UPS_BATT_HIGH_V=

# Alert thresholds (FR-021): input-voltage range and debounce window (seconds).
# Type: float / int  Required: no (defaults: 100 / 140 / 30)
ULTRON_UPS_INPUT_LOW_V=
ULTRON_UPS_INPUT_HIGH_V=
ULTRON_UPS_DEBOUNCE_SECONDS=

# History retention in days (FR-019/FR-024).
# Type: int  Required: no (default: 30)
ULTRON_UPS_RETENTION_DAYS=

# DEV ONLY — mock UPS data so the card renders locally with no physical UPS and
# no deploy (NFR-022). Values: OL | OB | LB | RB | BYPASS | OFF | ALARM |
# unreachable | 1 (cycle OL→OB→LB→unreachable). MUST be unset in production —
# the systemd unit does not set it, and with it unset the module only ever talks
# to the real read-only NUT endpoint.
# Type: string  Required: no (MUST be empty in production)
ULTRON_UPS_MOCK=
