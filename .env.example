# Ultron-AP — Environment Variables
# Copy to .env and fill in values before starting.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Admin password (bcrypt hash — NOT plaintext).
# Generate: htpasswd -bnBC 10 "" <password> | tr -d ':\n'
# Type:     string  Required: yes
# Example:  $2y$10$e0NRm...
ULTRON_ADMIN_PASS=

# ── Server ────────────────────────────────────────────────────────────────────

# HTTP listen port.
# Type: integer  Required: no  Default: 8080
ULTRON_PORT=8080

# Absolute path to the SQLite database file.
# Type: string  Required: no  Default: ./ultron.db
ULTRON_DB_PATH=/var/lib/ultron-ap/ultron.db

# Unix socket path for the privileged helper IPC channel.
# Type: string  Required: no  Default: /run/ultron-helper.sock
ULTRON_HELPER_SOCKET=/run/ultron-helper.sock

# ── Telegram Notifications (FR-005) ───────────────────────────────────────────

# Telegram bot token from @BotFather.
# Type: string  Required: no (feature disabled when empty)
# Example: 123456789:AAFhpVsO...
ULTRON_TELEGRAM_TOKEN=

# Telegram chat ID to receive alert messages.
# Type: string  Required: no (feature disabled when empty)
# Example: -1001234567890
ULTRON_TELEGRAM_CHAT_ID=

# ── Email Notifications (FR-006) ──────────────────────────────────────────────

# SMTP server hostname.
# Type: string  Required: no (feature disabled when empty)
# Example: smtp.example.com
ULTRON_SMTP_HOST=

# SMTP server port.
# Type: integer  Required: no  Default: 587
ULTRON_SMTP_PORT=587

# SMTP authentication username.
# Type: string  Required: no
# Example: alerts@example.com
ULTRON_SMTP_USER=

# SMTP authentication password.
# Type: string  Required: no
ULTRON_SMTP_PASS=

# Sender address for outgoing alert emails.
# Type: string  Required: no
# Example: ultron-alerts@example.com
ULTRON_SMTP_FROM=

# ── Backup Encryption ─────────────────────────────────────────────────────────

# AES-256 key (passphrase) used when BackupConfig.encrypt_enabled=1 and
# BackupConfig.encryption_key_ref="env:ULTRON_BACKUP_KEY". Required for the
# automated backup job to succeed when encryption is on; otherwise the job
# fails with "backup encryption key reference is empty" and no .db.enc is
# produced. Use a long, high-entropy value — backups are unrecoverable
# without this exact key.
# Type: string  Required: only when encryption is enabled in BackupConfig
ULTRON_BACKUP_KEY=
