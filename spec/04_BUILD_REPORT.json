{
  "project_name": "Ultron-AP",
  "version": "1.0.0",
  "module": "github.com/cesareyeserrano/ultron-ap",
  "language": "Go",
  "test_runner": "bash scripts/aitri-test.sh",
  "setup_commands": [
    "go mod download",
    "make css",
    "make build",
    "make build-arm"
  ],
  "environment_variables": [
    {
      "name": "ULTRON_ADMIN_USER",
      "default": "admin",
      "required": false,
      "description": "Admin username for first-run setup"
    },
    {
      "name": "ULTRON_ADMIN_PASS",
      "required": true,
      "description": "Initial admin password on first run; ignored after the user is seeded"
    },
    {
      "name": "ULTRON_PORT",
      "default": "8080",
      "required": false,
      "description": "HTTP listen port"
    },
    {
      "name": "ULTRON_DB_PATH",
      "default": "/var/lib/ultron-ap/db.sqlite",
      "required": false,
      "description": "Path to SQLite database file"
    },
    {
      "name": "ULTRON_LOG_LEVEL",
      "default": "info",
      "required": false,
      "description": "Logging level: debug | info | warn | error"
    },
    {
      "name": "ULTRON_SESSION_TTL",
      "default": "24h",
      "required": false,
      "description": "Session cookie TTL (Go duration string)"
    },
    {
      "name": "ULTRON_METRICS_INTERVAL",
      "default": "5s",
      "required": false,
      "description": "Metric collection interval (≥ 1s)"
    },
    {
      "name": "ULTRON_HELPER_SOCKET",
      "default": "/run/ultron-helper.sock",
      "required": false,
      "description": "Unix socket path for the privileged helper"
    }
  ],
