  "technical_debt": [],
  "entry_points": [
    {
      "path": "cmd/ultron-ap/main.go",
      "description": "Binary entry point; loads config, initializes DB, starts Server"
    },
    {
      "path": "cmd/ultron-helper/main.go",
      "description": "Privileged helper binary; listens on Unix socket, executes host-level actions as root"
    }
  ],
  "packages": [
    {
      "package": "internal/server",
      "responsibility": "HTTP request handling, SSE broadcasting, authentication middleware, template rendering, backup encryption",
      "key_types": [
        "Server",
        "sseBroker"
      ]
    },
    {
      "package": "internal/metrics",
      "responsibility": "Read system metrics (CPU, RAM, Disk, Network, Temperature); maintain ring buffer for chart history; emit snapshots",
      "key_types": [
        "Collector",
        "SystemReader",
        "RingBuffer",
        "Snapshot"
      ]
    },
    {
      "package": "internal/docker",
      "responsibility": "Connect to Docker socket, poll container state and stats, execute start/stop/restart/logs",
      "key_types": [
        "Monitor",
        "Client",
        "ContainerInfo"
      ]
    },
    {
      "package": "internal/systemd",
      "responsibility": "Read Systemd unit state, execute service controls via privileged helper, parse output",
      "key_types": [
        "Monitor",
        "ServiceInfo"
      ]
    },
    {
      "package": "internal/tailscale",
      "responsibility": "Read Tailscale VPN status and peer list from local CLI",
      "key_types": [
        "Status",
        "Peer"
      ]
    },
    {
      "package": "internal/alerts",
      "responsibility": "Evaluate threshold rules against metric snapshots and service state; fire/resolve alerts",
      "key_types": [
        "Engine",
        "Rule",
        "Alert"
      ]
    },
    {
      "package": "internal/notify",
      "responsibility": "Dispatch alert notifications to configured Telegram and Email channels",
      "key_types": [
        "Dispatcher",
        "TelegramNotifier",
        "EmailNotifier"
      ]
    },
    {
      "package": "internal/database",
      "responsibility": "SQLite data access layer for all persistent state: users/sessions, alerts, notification config, action history, backups, secrets",
      "key_types": [
        "DB"
      ]
    },
    {
      "package": "internal/auth",
      "responsibility": "CSRF token generation and validation; brute-force login attempt tracking",
      "key_types": [
        "CSRFManager",
        "BruteForceTracker"
      ]
    },
    {
      "package": "internal/config",
      "responsibility": "Load and validate server configuration from environment variables",
      "key_types": [
        "Config"
      ]
    },
    {
      "package": "internal/privileged",
      "responsibility": "Unix socket client; sends host-level action requests to the privileged helper binary",
      "key_types": [
        "Client"
      ]
    }
  ],
  "build": {
    "makefile_targets": {
      "build": "Compile for host architecture",
      "build-arm": "Cross-compile linux/arm64 binary (CGO_ENABLED=0)",
      "css": "Compile Tailwind CSS (requires tailwindcss binary)",
      "test": "Run Go test suite"
    },
    "output_binary": "bin/ultron-ap",
    "arm64_binary": "bin/ultron-ap-linux-arm64"
  },
  "quality_gates": [
    {
      "name": "vet",
      "command": "go vet ./...",
      "required": true
    },
    {
      "name": "security-gate",
      "command": "bash scripts/security-gate.sh",
      "required": true,
      "timeout_ms": 120000
    },
    {
      "name": "build-linux-arm64",
      "command": "sh scripts/build-arm64-check.sh",
      "required": true,
      "timeout_ms": 300000
    }
  ]
}
