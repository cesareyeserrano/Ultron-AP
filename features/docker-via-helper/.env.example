# docker-via-helper — variables de entorno relevantes
#
# Esta feature NO introduce ninguna variable nueva. Los timeouts son constantes
# del codigo a proposito: una variable de entorno seria una palanca para relajar
# la frontera de privilegio desde un fichero, y esa frontera es justamente lo
# que la feature establece (ver ADR y FLAG-2 en 02_SYSTEM_DESIGN.md).
#
# Las de abajo YA EXISTEN y son las que gobiernan el canal que esta feature
# ahora usa para leer Docker. Se listan porque un despliegue mal configurado
# aqui deja la seccion de contenedores en estado de error permanente.

# Socket del helper privilegiado. Debe coincidir con el que abre ultron-helper.
ULTRON_HELPER_SOCKET=/run/ultron-helper.sock

# Timeout del cliente del helper para las acciones que NO son de Docker
# (ping, systemctl, logs, shutdown). Las de Docker usan su propio presupuesto
# de 3s, fijado en codigo.
ULTRON_HELPER_TIMEOUT=5s

# Allowlist de UID que el helper acepta en su socket. En la Pi se resuelve solo
# desde el usuario 'ultron'; se declara explicitamente cuando ese usuario no es
# resoluble. Sin allowlist el helper falla CERRADO y rechaza todo (BG-043).
# ULTRON_HELPER_ALLOWED_UIDS=997

# Grupo propietario del socket del helper. En la Pi es 'ultron', que es lo que
# permite a la web app hablarle sin pertenecer al grupo docker.
ULTRON_HELPER_SOCKET_GROUP=ultron
