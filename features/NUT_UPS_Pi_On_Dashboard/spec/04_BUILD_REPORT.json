  "technical_debt": [
    {
      "fr_id": "FR-022",
      "substitution": "UPS insights are produced by a dedicated producer (internal/ups/insights.go) instead of being fed through the bundled insights rule engine via EvalWithVars as the design proposed.",
      "reason": "The bundled rule set is locked at exactly 10 rules by the parent FR-047 (TestBundled_TenRulesLoadCleanly), and the engine emits STATIC verdict text — it cannot interpolate the outage count (adversarial finding #3). The dedicated producer avoids breaking the FR-047 contract and actually renders the REAL count ('3 cortes esta semana'), which the engine could not. FR-022 is NICE/P2.",
      "effort_to_fix": "medium"
    },
    {
      "fr_id": "FR-017",
      "substitution": "The e2e-typed UX test cases (card render, escaping, shutdown block, mock render) are implemented as Go server-render tests (httptest + goquery-free string assertions on the rendered partial) rather than a real browser e2e run.",
      "reason": "The repository has no browser e2e runner (no Playwright/Cypress); server-side template render tests are the established convention across the codebase (network/lan modules). The live app was additionally verified manually in a browser via ULTRON_UPS_MOCK. Viewport/console-level assertions are approximated via CSS-class and structural checks.",
      "effort_to_fix": "low"
    }
  ],
