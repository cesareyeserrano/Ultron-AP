# NUT_UPS_Pi_On_Dashboard — feature environment variables
# These extend the main Ultron-AP .env.example (repo root). On the Pi they live
# in /etc/ultron-ap/ultron-ap.env, loaded by the systemd unit (EnvironmentFile).

# Enable the UPS module. Unset/false = fully inert (no NUT connection, no card,
# no alerts); the rest of the panel is unaffected.
ULTRON_UPS_ENABLED=true

# Dedicated READ-ONLY NUT user (create it in /etc/nut/upsd.users — see DEPLOYMENT.md).
# Do NOT reuse the homeassistant user. Never commit real values.
ULTRON_NUT_USER=ultron
ULTRON_NUT_PASS=

# NUT server address + device name (defaults suit the local upsd).
ULTRON_UPS_ADDR=127.0.0.1:3493
ULTRON_UPS_NAME=powest

# Poll interval / unreachable timeout (seconds).
ULTRON_UPS_POLL_SECONDS=10
ULTRON_UPS_UNREACHABLE_SECONDS=120

# Battery voltage bounds for the ESTIMATED % (low is also the "punto de apagado").
ULTRON_UPS_BATT_LOW_V=21.0
ULTRON_UPS_BATT_HIGH_V=27.4

# Alert thresholds: input-voltage range + debounce window (seconds).
ULTRON_UPS_INPUT_LOW_V=100
ULTRON_UPS_INPUT_HIGH_V=140
ULTRON_UPS_DEBOUNCE_SECONDS=30

# History retention (days).
ULTRON_UPS_RETENTION_DAYS=30

# DEV ONLY — mock UPS data (NFR-022). MUST be unset in production; the systemd
# unit does not set it. Values: OL|OB|LB|RB|BYPASS|OFF|ALARM|unreachable|1 (cycle).
# ULTRON_UPS_MOCK=
