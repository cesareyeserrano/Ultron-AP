# net-sample-retention — variables de entorno

# Ventana de retencion de NetSample, en dias (FR-096/FR-097).
# Tipo: int   Requerida: no   Defecto: 30   Minimo: 1
#
# Sin esto la tabla crecia sin techo: 8,4 M filas y 694 MB — el 96% de la base —
# el 2026-09-06, a razon de ~67.000 filas y 5,5 MB diarios. Tamanos esperados en
# regimen estacionario: ~40 MB con 7 dias, ~175 MB con 30, ~510 MB con 90.
#
# Un valor invalido (no numerico, 0 o negativo) registra un aviso y cae a 30 en
# vez de abortar el arranque: 0 significaria "borra todo el historico" y una
# ventana negativa pone el corte en el futuro, que tambien lo borra todo.
ULTRON_NET_RETENTION_DAYS=30

# Intervalo de muestreo del monitor de red, en segundos (FR-100).
# Tipo: int   Requerida: no   Defecto: 5   Minimo: 1
#
# 5 es exactamente el valor que estaba fijo en el codigo antes de que esto fuera
# configurable, asi que dejarlo sin definir no cambia nada observable. Subirlo a
# 15 reduce el crecimiento del historico unas tres veces; el compromiso es que un
# corte mas breve que el intervalo puede caer entre dos muestras (misma clase de
# problema que BL-041 documenta para el sondeo del UPS).
ULTRON_NET_INTERVAL_SECONDS=15
