# network-alerts adds no feature-specific environment variables.
# These parent Ultron-AP values are shown for optional local compose testing.

ULTRON_PORT=8080
ULTRON_DB_PATH=/var/lib/ultron-ap/ultron.db
ULTRON_ADMIN_PASS=$2a$10$examplebcryptadminhashreplacebeforeuse
ULTRON_SECRET_KEY=replace-with-32-byte-random-secret
ULTRON_NET_TARGETS=gateway,1.1.1.1=1.1.1.1,8.8.8.8=8.8.8.8,dns:dns=1.1.1.1/cloudflare.com
